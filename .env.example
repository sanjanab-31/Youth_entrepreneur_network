DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=REPLACE_ME
DB_NAME=vanguard_db
DB_PORT=5432
PORT=5000
FRONTEND_URL=http://localhost:5173
# For multiple deployed frontends, separate origins with commas.
# Example: FRONTEND_URLS=https://your-app.vercel.app,https://www.your-app.vercel.app
FRONTEND_URLS=http://localhost:5173
# Firebase service account credentials should be provided as a single JSON string
# or set the individual variables below. DO NOT commit secrets to the repo.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
# For the private key, either set FIREBASE_SERVICE_ACCOUNT_KEY as JSON,
# or set FIREBASE_PRIVATE_KEY with newlines escaped (\n). Do NOT put the
# real private key into the repo.
FIREBASE_PRIVATE_KEY="REPLACE_WITH_PRIVATE_KEY"

# Vite (frontend) environment variables (prefix with VITE_ to be available in the client)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id
